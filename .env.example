# Atlas report bot configuration (see docs/ATLAS.md)
ANTHROPIC_API_KEY=
PQ_DSN=postgresql://atlas_bot:CHANGE_ME@localhost:5432/atlas
# Optional privileged DSN, only used to resolve a tenant slug to its UUID
PQ_ADMIN_DSN=
# Tenant slug (needs PQ_ADMIN_DSN) or tenant UUID
PQ_TENANT=acme
# The conversation's "today"; Atlas demo data ends 2026-07-06
PQ_AS_OF=2026-07-06
PQ_MODEL=claude-sonnet-5-5
PQ_FAST_MODEL=claude-haiku-5-5
PQ_AUDIT_LOG=./audit.jsonl
PQ_ROW_CAP=1000
# Optional disk cache of model responses (evals / replay)
PQ_LLM_CACHE=
# Optional: require this key (X-API-Key header) on every API route except /healthz
PQ_API_KEY=
